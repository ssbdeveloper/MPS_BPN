FROM python:3.11-slim

# Driver: pymssql (bundled FreeTDS via its PyPI wheel) — no system ODBC driver,
# no Microsoft apt repo needed. Only pip is used, so this builds even where
# packages.microsoft.com / Debian mirrors are blocked.
#
# Run:
#   docker compose -f docker-compose.heartbeat.yml up -d --build
#   docker logs -f machine-heartbeat-sync
#   docker compose -f docker-compose.heartbeat.yml down

WORKDIR /app

COPY requirements.heartbeat.txt ./
RUN pip install --no-cache-dir -r requirements.heartbeat.txt

COPY sync_machine_heartbeat.py ./

# -u = unbuffered stdout so `docker logs` shows progress live.
CMD ["python", "-u", "sync_machine_heartbeat.py"]
